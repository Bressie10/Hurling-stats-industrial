{
  "appName": "GAAstat",
  "appId": "com.gaastat.app",
  "productionUrl": "https://www.gaastat.com/",
  "supportEmail": "contact@gaastatsapp.com",
  "storeMode": {
    "queryParam": "store_build",
    "localStorageKey": "gaastat-store-build",
    "allowedValues": ["ios", "android"]
  },
  "publicUrls": {
    "privacy": "https://www.gaastat.com/privacy",
