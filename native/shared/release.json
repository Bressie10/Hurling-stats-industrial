{
  "appName": "PitchNote",
  "appId": "ie.pitchnote.app",
  "productionUrl": "https://www.pitchnote.ie/",
  "supportEmail": "support@pitchnote.ie",
  "storeMode": {
    "queryParam": "store_build",
    "localStorageKey": "pitchnote-store-build",
    "allowedValues": ["ios", "android"]
  },
  "publicUrls": {
    "privacy": "https://www.pitchnote.ie/privacy",
    "terms": "https://www.pitchnote.ie/terms",
    "support": "https://www.pitchnote.ie/support",
    "accountDeletion": "https://www.pitchnote.ie/account/delete"
  },
  "ios": {
    "bundleId": "ie.pitchnote.app",
    "wrapper": "Capacitor",
    "launchUrl": "https://www.pitchnote.ie/?store_build=ios",
    "microphoneUsageDescription": "PitchNote uses the microphone for on-device voice logging and optional assistant questions."
  },
  "android": {
    "packageName": "ie.pitchnote.app",
    "wrapper": "Capacitor",
    "launchUrl": "https://www.pitchnote.ie/?store_build=android"
  }
}
